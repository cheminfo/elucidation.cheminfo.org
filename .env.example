# Copy to .env: cp .env.example .env

# Deployment mode: uncomment exactly ONE line to choose how the service is exposed.
# With none uncommented, docker compose uses compose.yaml by default.
# COMPOSE_FILE=compose.yaml          # port-published (publishes PORT on the host)
# COMPOSE_FILE=compose.traefik.yaml  # behind a Traefik reverse proxy

# Host port for the frontend in the port-published mode.
PORT=10718

# Frontend image selected by every compose file. IMAGE_TAG is rewritten by the
# server's deploy script on each deploy and rollback - do not edit it by hand.
# Left at latest, docker compose runs the released image.
IMAGE_NAME=ghcr.io/cheminfo/elucidation.cheminfo.org
IMAGE_TAG=latest

# Analytics. The snippet the provider hands out, pasted whole and on one line:
# the container puts it at the end of the <head> of every page it serves — one
# file per address is written by the build, so a visitor is counted whichever
# one they arrived at. Unset — a dev run, or a deployment that measures nothing
# — nothing is loaded. Each site has its own id, from https://datami.cheminfo.org.
# TRACKING_SCRIPT=<script defer src="https://datami.cheminfo.org/script.js" data-website-id="80069e2f-319c-4189-954d-2f4712de09c5"></script>
